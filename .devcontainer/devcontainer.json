{
  "name": "radi-snipper",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "userGid": "1000",
      "userUid": "1000",
      "username": "vscode",
      "upgradePackages": true
    },
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": {
            "path": "/home/linuxbrew/.linuxbrew/bin/fish"
          }
        },
        "mise.binPath": "/home/linuxbrew/.linuxbrew/bin/mise"
      },
      "extensions": [
        "hverlin.mise-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "postCreateCommand": "./.devcontainer/post-create.sh",
  "initializeCommand": "xhost +SI:localuser:$(whoami)",
  "forwardPorts": [
    5173,
    9222
  ],
  "mounts": [
    {
      "source": "${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}",
      "target": "${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}",
      "type": "bind"
    },
    {
      "source": "/tmp/.X11-unix",
      "target": "/tmp/.X11-unix",
      "type": "bind"
    },
    {
      "source": "mise-data-volume",
      "target": "/mnt/mise-data",
      "type": "volume"
    },
    {
      "source": "linuxbrew-data-volume",
      "target": "/home/linuxbrew/.linuxbrew",
      "type": "volume"
    },
  ],
  "securityOpt": [
    "label=type:container_runtime_t"
  ],
  "containerEnv": {
    "MISE_DATA_DIR": "/mnt/mise-data",
    "DISPLAY": "${localEnv:DISPLAY}",
    "XDG_RUNTIME_DIR": "/tmp",
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/mnt/mise-data/shims"
  },
}